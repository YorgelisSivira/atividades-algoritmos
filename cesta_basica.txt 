Algoritmo "Monitoramento_Cesta_Basica"

Variáveis
    // Variáveis do Produto 1
    prod1: Texto
    preco_ant1, preco_at1, variacao1: Real
    
    // Variáveis do Produto 2
    prod2: Texto
    preco_ant2, preco_at2, variacao2: Real
    
    // Variáveis do Produto 3
    prod3: Texto
    preco_ant3, preco_at3, variacao3: Real

Início
    // -------------------------------------------------------------
    // ENTRADA DE DADOS (Coleta sequencial via teclado)
    // -------------------------------------------------------------
    Escreva("Digite o nome do primeiro produto: ")
    Leia(prod1)
    Escreva("Digite o preço do mês anterior de ", prod1, ": R$ ")
    Leia(preco_ant1)
    Escreva("Digite o preço do mês atual de ", prod1, ": R$ ")
    Leia(preco_at1)
    
    Escreva("Digite o nome do segundo produto: ")
    Leia(prod2)
    Escreva("Digite o preço do mês anterior de ", prod2, ": R$ ")
    Leia(preco_ant2)
    Escreva("Digite o preço do mês atual de ", prod2, ": R$ ")
    Leia(preco_at2)
    
    Escreva("Digite o nome do terceiro produto: ")
    Leia(prod3)
    Escreva("Digite o preço do mês anterior de ", prod3, ": R$ ")
    Leia(preco_ant3)
    Escreva("Digite o preço do mês atual de ", prod3, ": R$ ")
    Leia(preco_at3)

    // -------------------------------------------------------------
    // PROCESSAMENTO (Cálculo matemático das variações percentuais)
    // -------------------------------------------------------------
    variacao1 <- ((preco_at1 - preco_ant1) / preco_ant1) * 100
    variacao2 <- ((preco_at2 - preco_ant2) / preco_ant2) * 100
    variacao3 <- ((preco_at3 - preco_ant3) / preco_ant3) * 100

    // -------------------------------------------------------------
// EXIBIÇÃO DOS RESULTADOS
// -------------------------------------------------------------

EscrevaL("=====================================================")
EscrevaL("        RELATÓRIO DE VARIAÇÃO DE PREÇOS")
EscrevaL("=====================================================")

// Produto 1
EscrevaL("Produto: ", prod1)
EscrevaL("Preço anterior: R$ ", preco_ant1)
EscrevaL("Preço atual: R$ ", preco_at1)
EscrevaL("Variação percentual: ", variacao1, "%")

Se (variacao1 > 0) Entao
    EscrevaL("Situação: AUMENTO")
Senao
    Se (variacao1 < 0) Entao
        EscrevaL("Situação: REDUÇÃO")
    Senao
        EscrevaL("Situação: ESTÁVEL")
    FimSe
FimSe

EscrevaL("-----------------------------------------------------")

// Produto 2
EscrevaL("Produto: ", prod2)
EscrevaL("Preço anterior: R$ ", preco_ant2)
EscrevaL("Preço atual: R$ ", preco_at2)
EscrevaL("Variação percentual: ", variacao2, "%")

Se (variacao2 > 0) Entao
    EscrevaL("Situação: AUMENTO")
Senao
    Se (variacao2 < 0) Entao
        EscrevaL("Situação: REDUÇÃO")
    Senao
        EscrevaL("Situação: ESTÁVEL")
    FimSe
FimSe

EscrevaL("-----------------------------------------------------")

// Produto 3
EscrevaL("Produto: ", prod3)
EscrevaL("Preço anterior: R$ ", preco_ant3)
EscrevaL("Preço atual: R$ ", preco_at3)
EscrevaL("Variação percentual: ", variacao3, "%")

Se (variacao3 > 0) Entao
    EscrevaL("Situação: AUMENTO")
Senao
    Se (variacao3 < 0) Entao
        EscrevaL("Situação: REDUÇÃO")
    Senao
        EscrevaL("Situação: ESTÁVEL")
    FimSe
FimSe

EscrevaL("=====================================================")
